{
  "name": "erasmusu",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "packages/domain",
    "backend",
    "app"
  ],
  "scripts": {
    "build:domain": "npm run build --workspace=@erasmusu/domain",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build:domain && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
