{
  "expo": {
    "name": "Erasmusu",
    "slug": "erasmusu",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Erasmusu usa tu ubicación para encontrar la fuente potable más cercana."
      }
    },
    "android": {
      "package": "com.erasmusu.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Erasmusu usa tu ubicación para encontrar la fuente potable más cercana."
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
